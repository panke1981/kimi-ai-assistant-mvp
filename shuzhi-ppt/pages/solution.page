pageType: content
background:
  type: solid
  color: "$bgContent"
elements:
  - elementId: pageLabel
    elementType: text
    bounds: [60, 35, 200, 20]
    content:
      style: "$label"
      text: |
        <p>SOLUTION OVERVIEW</p>
      wrap: false
  - elementId: pageTitle
    elementType: text
    bounds: [60, 60, 900, 45]
    content:
      style: "$heading"
      text: |
        <p>数观：从数据到决策的一站式闭环</p>
      wrap: false
  - elementId: titleUnderline
    elementType: shape
    bounds: [60, 115, 1160, 1]
    shapeName: rect
    fill: {type: solid, color: "$cardBorder"}
  - elementId: step1Bg
    elementType: shape
    bounds: [60, 160, 200, 200]
    shapeName: rect
    fill: {type: solid, color: "$cardBg"}
    border: {style: solid, width: 1, color: "$primary"}
  - elementId: step1Num
    elementType: text
    bounds: [75, 175, 40, 30]
    content:
      fontSize: 20
      fontFamily: "Liter"
      fill:
      type: solid
      color: "$accent"
      text: |
        <p>01</p>
      wrap: false
  - elementId: step1Title
    elementType: text
    bounds: [75, 215, 170, 30]
    content:
      style: "$body"
      fontSize: 18
      text: |
        <p><strong>上传数据</strong></p>
      wrap: false
  - elementId: step1Desc
    elementType: text
    bounds: [75, 250, 170, 90]
    content:
      style: "$body"
      fontSize: 16
      color: "$textMuted"
